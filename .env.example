# ==========================================
# NOVA Platform Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Support for both MONGO_URI and URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nova?retryWrites=true&w=majority
URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nova?retryWrites=true&w=majority

# JWT Authentication Secrets
# Support for both standard and legacy secret keys
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
SECRET=your_jwt_access_secret_min_32_chars_long
SECRET_FOR_FORGOT=your_jwt_forgot_password_secret_key

# Frontend Client URL
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / SMTP (Gmail or custom SMTP)
EMAIL=your_email@gmail.com
PASS=your_app_specific_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# WebRTC STUN/TURN Configuration (Optional for production TURN relay)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=
